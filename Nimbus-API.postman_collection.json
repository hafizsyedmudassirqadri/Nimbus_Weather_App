    {
      "name": "1 · Auth (Lesson 3)",
      "description": "",
      "item": [
        {
          "name": "Login (saves token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Screens 02/03. Saves the JWT into {{token}} automatically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@nimbus.app\",\n  \"password\": \"demo1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Login returns a token', () => { pm.expect(j.token).to.be.a('string'); });",
                  "pm.environment.name ? pm.environment.set(\"token\", j.token) : pm.collectionVariables.set(\"token\", j.token);"
                ]
              }
            }
          ]
        },
